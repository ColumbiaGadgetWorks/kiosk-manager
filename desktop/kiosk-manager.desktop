[Desktop Entry]
Type=Application
Version=1.0
Name=Kiosk Manager
GenericName=Kiosk configuration
Comment=Configure the kiosk page, schedule and screen timeout
Exec=kiosk-manager gui
Icon=preferences-system
Terminal=false
Categories=Settings;System;
StartupNotify=false
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=8
